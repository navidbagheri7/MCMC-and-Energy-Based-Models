include README.md LICENSE CITATION.cff CONTRIBUTING.md CHANGELOG.md .gitignore .nojekyll requirements-reference.txt
recursive-include configs *.json
recursive-include docs *.md *.json *.csv *.html
recursive-include assets *.png *.pdf *.npz *.json
recursive-include notebooks *.ipynb *.md
recursive-include scripts *.py *.html *.js
recursive-include tests *.py
recursive-include results/reference *.json *.npz
recursive-include .github *.yml
include legacy/manifest.json
prune legacy/originals
prune .local
prune results/smoke
recursive-exclude * __pycache__ *.py[cod]
global-exclude *.pt *.log

exclude docs/release_artifacts.json

include index.html
